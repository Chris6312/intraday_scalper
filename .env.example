# Application
APP_ENV=local
LOG_LEVEL=INFO
EXECUTION_MODE=PAPER
MARKET_DATA_PROVIDER=PUBLIC
EXECUTION_BROKER=INTERNAL_PAPER
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://scalper:scalper@localhost:5432/options_scalper
POSTGRES_DB=options_scalper
POSTGRES_USER=scalper
POSTGRES_PASSWORD=replace_for_local_only

# Public market data - never commit real values
PUBLIC_API_BASE_URL=https://api.public.com
PUBLIC_API_SECRET=uDLs5V5eV3iowo2XtQSOEfwS5kVuXUwy
PUBLIC_ACCOUNT_ID=5OG43294
PUBLIC_ACCESS_TOKEN_TTL_MINUTES=15

# Paper account and strategy ceiling
PAPER_STARTING_BALANCE=25000.00
STRATEGY_BUYING_POWER_FRACTION=0.50

# Conservative simulation defaults
SIM_COMMISSION_PER_CONTRACT_PER_SIDE=0.65
SIM_REGULATORY_FEE_PER_SELL_CONTRACT=0.03
SIM_ENTRY_SLIPPAGE_TICKS=1
SIM_NORMAL_EXIT_SLIPPAGE_TICKS=1
SIM_STOP_SLIPPAGE_TICKS=2
SIM_UNKNOWN_SIZE_MAX_CONTRACTS_PER_QUOTE=1
SIM_UNKNOWN_SIZE_REFILL_DELAY_MS=250

# Freshness and candle completion
UNDERLYING_QUOTE_STALE_SECONDS=5
OPTION_QUOTE_STALE_SECONDS=3
COMPLETED_CANDLE_GRACE_SECONDS=2

# Optional adapters
ALPACA_COMPARISON_ENABLED=false
WEBULL_ADAPTER_ENABLED=false
