APP_ENV=local
EXECUTION_MODE=PAPER
MARKET_DATA_PROVIDER=PUBLIC
EXECUTION_BROKER=INTERNAL_PAPER
DATABASE_URL=postgresql+asyncpg://scalper:scalper@localhost:5432/options_scalper
PUBLIC_API_SECRET=replace_me
PUBLIC_ACCOUNT_ID=replace_me
PAPER_STARTING_BALANCE=25000.00
PUBLIC_TOKEN_REFRESH_LEEWAY_SECONDS=30
PUBLIC_CONNECT_TIMEOUT_SECONDS=5
PUBLIC_READ_TIMEOUT_SECONDS=10
PUBLIC_WRITE_TIMEOUT_SECONDS=10
PUBLIC_POOL_TIMEOUT_SECONDS=5
PUBLIC_MAX_RETRIES=2
PUBLIC_RETRY_BASE_DELAY_SECONDS=0.25
